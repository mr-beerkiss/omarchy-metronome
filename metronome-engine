#!/usr/bin/env python3
"""Generate a steady, accented metronome click through PipeWire."""

from array import array
import math
import shutil
import signal
import subprocess
import sys


SAMPLE_RATE = 48_000
CHUNK_FRAMES = 256
CLICK_SECONDS = 0.032


def bounded_int(value: str, minimum: int, maximum: int, name: str) -> int:
    try:
        number = int(value)
    except ValueError as error:
        raise SystemExit(f"Invalid {name}: {value}") from error
    return max(minimum, min(maximum, number))


def player_command() -> list[str]:
    if shutil.which("pw-play"):
        return [
            "pw-play", "--raw", "--format", "s16", "--rate", str(SAMPLE_RATE),
            "--channels", "1", "--latency", "20ms", "--media-role", "Music", "-",
        ]
    if shutil.which("aplay"):
        return ["aplay", "-q", "-r", str(SAMPLE_RATE), "-f", "S16_LE", "-c", "1"]
    raise SystemExit("Metronome needs pw-play or aplay, but neither was found.")


def main() -> int:
    bpm = bounded_int(sys.argv[1] if len(sys.argv) > 1 else "120", 30, 240, "BPM")
    beats_per_bar = bounded_int(sys.argv[2] if len(sys.argv) > 2 else "4", 1, 12, "beats per bar")
    volume = bounded_int(sys.argv[3] if len(sys.argv) > 3 else "65", 1, 100, "volume") / 100.0

    player = subprocess.Popen(
        player_command(),
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    running = True

    def stop(_signum: int, _frame: object) -> None:
        nonlocal running
        running = False
        if player.poll() is None:
            player.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    frames_per_beat = SAMPLE_RATE * 60.0 / bpm
    click_frames = int(SAMPLE_RATE * CLICK_SECONDS)
    phase = 0.0
    beat = 0

    try:
        while running and player.poll() is None:
            samples = array("h")
            for _ in range(CHUNK_FRAMES):
                if phase < click_frames:
                    accented = beat % beats_per_bar == 0
                    frequency = 1320.0 if accented else 880.0
                    gain = volume * (0.80 if accented else 0.56)
                    envelope = math.exp(-7.0 * phase / click_frames)
                    transient = math.exp(-35.0 * phase / click_frames)
                    wave = math.sin(2.0 * math.pi * frequency * phase / SAMPLE_RATE)
                    sample = int(32767 * gain * envelope * wave + 32767 * gain * 0.12 * transient)
                    samples.append(max(-32767, min(32767, sample)))
                else:
                    samples.append(0)

                phase += 1.0
                if phase >= frames_per_beat:
                    phase -= frames_per_beat
                    beat += 1

            if player.stdin is None:
                break
            player.stdin.write(samples.tobytes())
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        if player.stdin is not None:
            try:
                player.stdin.close()
            except BrokenPipeError:
                pass
        if player.poll() is None:
            player.terminate()
        try:
            player.wait(timeout=1)
        except subprocess.TimeoutExpired:
            player.kill()

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
